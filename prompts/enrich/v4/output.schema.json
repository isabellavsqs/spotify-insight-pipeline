{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enrich-v4/output",
  "description": "Normalized result saved per distinct text after validating Jev's answers for that review (each must be an offered option).",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic", "intent", "severity", "sentiment", "quote_index", "evidence_quote", "needs_review", "issue", "entities"],
  "properties": {
    "topic": {"enum": ["access", "usability", "playback", "downloads", "catalog", "billing", "support", "other"]},
    "intent": {"enum": ["cancellation", "complaint", "request", "praise", "unclear"]},
    "severity": {"type": "integer", "minimum": 1, "maximum": 5},
    "sentiment": {"enum": [-1.0, -0.5, 0.0, 0.5, 1.0]},
    "quote_index": {"type": "integer", "minimum": 1},
    "evidence_quote": {"type": "string", "minLength": 1, "description": "Exact substring of the review text (deterministic choice)"},
    "needs_review": {"type": "boolean"},
    "issue": {"type": "string", "pattern": "^(none|[a-z]+\\.[a-z_]+)$"},
    "entities": {"type": "array", "items": {"type": "string"}}
  }
}
