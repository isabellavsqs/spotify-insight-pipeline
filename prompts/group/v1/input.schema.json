{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "group-v1/input",
  "description": "Bounded evidence pack built by code from saved records and membership. It covers every issue in the baseline ranking. Quotes are chosen deterministically: up to 6 per issue, evidence quotes cut to 200 characters, ordered by severity desc, then review_likes desc, then review_id. Likes are used only to choose examples, never as a label input. The pack never contains the full CSV.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_id", "issues"],
  "properties": {
    "pack_id": {"type": "string", "description": "SHA-256 of the canonical pack; saved and logged so the group call can be reproduced"},
    "issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_id", "topic", "complaint_count", "mean_severity", "top_entities", "quotes"],
        "properties": {
          "issue_id": {"type": "string", "pattern": "^[a-z]+\\.[a-z_]+$"},
          "topic": {"enum": ["access", "usability", "playback", "downloads", "catalog", "billing", "support", "other"]},
          "complaint_count": {"type": "integer", "minimum": 1},
          "mean_severity": {"type": "string", "pattern": "^[1-5]\\.[0-9]{6}$"},
          "top_entities": {"type": "array", "maxItems": 5, "items": {"type": "string"}},
          "quotes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quote_id", "severity", "text"],
              "properties": {
                "quote_id": {"type": "string", "pattern": "^q[0-9]{4}$"},
                "severity": {"type": "integer", "minimum": 1, "maximum": 5},
                "text": {"type": "string", "maxLength": 200}
              }
            }
          }
        }
      }
    }
  }
}
